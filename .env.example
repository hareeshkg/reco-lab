# Application
APP_BASE_URL=http://localhost:3000
DATABASE_URL=file:./data/recolab.db
APP_ENCRYPTION_KEY=replace-with-a-generated-32-byte-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Gmail
GMAIL_SCOPE=https://www.googleapis.com/auth/gmail.readonly
GMAIL_DEFAULT_QUERY=
GMAIL_IMPORT_START_DATE=

# Market data
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=

# Optional AI extraction - disabled by default
AI_EXTRACTION_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Storage controls
STORE_RAW_EMAILS=false
STORE_RAW_ATTACHMENTS=false

# Logging
LOG_LEVEL=info
